# ============================================================
# Template .env per museumguard.
# NON committare i file .env.* reali (vedi .gitignore) — questo
# .env.example serve solo da riferimento per chi clona il repo.
#
# Uso pratico con due scenari (mock vs hardware reale):
#   cp .env.example .env.mock   -> compila con i valori per i mock
#   cp .env.example .env.real   -> compila con gli IP reali dell'ESP32
#
#   docker compose --env-file .env.mock --profile mock up
#   docker compose --env-file .env.real up
# ============================================================

# --- InfluxDB ---
INFLUXDB_USERNAME=admin
INFLUXDB_PASSWORD=admin123
INFLUXDB_ORG=myorg
INFLUXDB_BUCKET=museum_data
INFLUXDB_TOKEN=my-super-token

# --- Grafana ---
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# --- Device: dove trova il sensore e l'attuatore ---
# Scenario MOCK: usa i nomi dei container (risolvono via rete Docker interna)
#   ESP_SEN_ADDRESS=esp-sen-mock
#   ESP_ACT_ADDRESS=esp-act-mock
#
# Scenario HARDWARE REALE: usa gli IP dell'ESP32 sulla tua LAN
# (stessa rete WiFi del PC che fa girare docker compose)
#   ESP_SEN_ADDRESS=192.168.x.x
#   ESP_ACT_ADDRESS=192.168.x.x
ESP_SEN_ADDRESS=esp-sen-mock
ESP_ACT_ADDRESS=esp-act-mock

COAP_PORT=5683
HTTP_PORT=80

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_CHAT_ID=

# --- Mashup Express server for Grafana Communications ---
MASHUP_SERVER_API_PORT=3001
