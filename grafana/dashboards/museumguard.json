{
  "title": "MuseumGuard",
  "uid": "museumguard-main",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "timezone": "browser",
  "tags": ["museumguard"],
  "panels": [
    {
      "id": 1,
      "title": "Ambient light (%)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "influxdb", "uid": "influxdb_museumguard" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: v.bucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"ambient_light\")\n  |> filter(fn: (r) => r._field == \"value\")"
        }
      ]
    },
    {
      "id": 2,
      "title": "Acceleration X/Y/Z (g)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "influxdb", "uid": "influxdb_museumguard" },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: v.bucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"acceleration\")\n  |> filter(fn: (r) => r._field == \"ax\" or r._field == \"ay\" or r._field == \"az\")"
        }
      ]
    },
    {
      "id": 3,
      "title": "Impact events",
      "type": "table",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "datasource": { "type": "influxdb", "uid": "influxdb_museumguard" },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "renameByName": {
              "_time": "Time",
              "x": "X Axis",
              "y": "Y Axis",
              "z": "Z Axis"
            },
            "indexByName": {}
          }
        }
      ],
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: v.bucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"impact_event\")\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> drop(columns: [\"_start\", \"_stop\", \"system\"])\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"axis\"], valueColumn: \"value\")\n  |> sort(columns: [\"_time\"], desc: true)"
        }
      ]
    },
    {
      "id": 4,
      "title": "Theft events",
      "type": "table",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "datasource": { "type": "influxdb", "uid": "influxdb_museumguard" },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "renameByName": {
              "_time": "Time",
              "x": "X Axis",
              "y": "Y Axis",
              "z": "Z Axis"
            },
            "indexByName": {}
          }
        }
      ],
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: v.bucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"theft_event\")\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> drop(columns: [\"_start\", \"_stop\", \"system\"])\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"axis\"], valueColumn: \"value\")\n  |> sort(columns: [\"_time\"], desc: true)"
        }
      ]
    },
    {
      "id": 5,
      "title": "Alarm state (actuator)",
      "type": "stat",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "datasource": { "type": "influxdb", "uid": "influxdb_museumguard" },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"],
          "fields": "/^alarm_state$/"
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": {
              "IDLE":   { "color": "green",  "text": "IDLE" },
              "IMPACT": { "color": "orange", "text": "IMPACT" },
              "THEFT":  { "color": "red",    "text": "THEFT" }
            }}
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: v.bucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"actuator_state\")\n  |> filter(fn: (r) => r._field == \"alarm_state\")\n  |> last()\n  |> drop(columns: [\"_start\", \"_stop\", \"system\"])"
        }
      ]
    },
    {
      "id": 6,
      "title": "Artwork lighting intensity (%)",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "influxdb", "uid": "influxdb_museumguard" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: v.bucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"actuator_state\")\n  |> filter(fn: (r) => r._field == \"brightness\")\n  |> last()"
        }
      ]
    },
    {
      "id": 7,
      "title": "Lighting intensity over time (%)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "influxdb", "uid": "influxdb_museumguard" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: v.bucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"actuator_state\")\n  |> filter(fn: (r) => r._field == \"brightness\")"
        }
      ]
    },
    {
      "id": 8,
      "title": "Latest known GPS positions",
      "type": "table",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 24 },
      "datasource": { "type": "influxdb", "uid": "influxdb_museumguard" },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "renameByName": {
              "_time": "Time",
              "lat": "Latitude",
              "lon": "Longitude"
            },
            "indexByName": {}
          }
        }
      ],
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: v.bucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"position\")\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> drop(columns: [\"_start\", \"_stop\", \"system\"])\n  |> sort(columns: [\"_time\"], desc: false)\n"
        }
      ]
    },
    {
      "id": 9,
      "title": "Last GPS position (map)",
      "type": "geomap",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 32 },
      "datasource": { "type": "influxdb", "uid": "influxdb_museumguard" },
      "options": {
        "view": { "id": "coords", "lat": 44.64783, "lon": 10.92539, "zoom": 7, "padding": 0 },
        "layers": [
          {
            "type": "markers",
            "name": "Last GPS position",
            "location": { "mode": "auto"},
            "config": {
              "style": {
                "symbol": { "mode": "fixed", "fixed": "img/icons/marker/star.svg" },
                "color": { "fixed": "orange" },
                "size": { "fixed": 12 },
                "opacity": 1
              }
            },
            "tooltip": true
          }
        ],
        "controls": { "showZoom": true, "showAttribution": true, "showScale": false, "mouseWheelZoom": true }
      },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: v.bucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"position\")\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> drop(columns: [\"_start\", \"_stop\", \"system\"])\n  |> sort(columns: [\"_time\"], desc: true)\n  |> limit(n: 1)"
        }
      ]
    },
    {
      "id": 10,
      "title": "Predicted vs actual ambient light (%)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 42 },
      "datasource": { "type": "influxdb", "uid": "influxdb_museumguard" },
      "fieldConfig": { 
        "defaults": { "unit": "percent", "min": 0, "max": 100 }, 
        "overrides": [] 
      },
      "targets": [
        {
          "refId": "A",
          "query": "actual = from(bucket: v.bucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"ambient_light\")\n  |> filter(fn: (r) => r._field == \"value\")\n  |> set(key: \"_field\", value: \"actual\")\n\npredicted = from(bucket: v.bucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"predicted_light\")\n  |> filter(fn: (r) => r._field == \"predicted_value\")\n  |> set(key: \"_field\", value: \"predicted\")\n\nunion(tables: [actual, predicted])\n  |> sort(columns: [\"_time\"])"
        }
      ]
    },
    {
      "id": 11,
      "title": "Prediction error (predictive-light)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 42 },
      "datasource": { "type": "influxdb", "uid": "influxdb_museumguard" },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: v.bucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"prediction_error\")\n  |> filter(fn: (r) => r._field == \"error\" or r._field == \"ema_error\")"
        }
      ]
    },
    {
      "id": 12,
      "title": "Reset Alarm",
      "type": "volkovlabs-form-panel",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 52
      },
      "datasource": null,
      "options": {
        "layout": {
          "variant": "none"
        },
        "elements": [],
        "sync": false,
        "initial": {
          "method": "none"
        },
        "update": {
          "method": "POST",
          "url": "http://localhost:3001/api/resetalarm",
          "contentType": "application/json",
          "confirm": true
        },
        "confirmModal": {
          "body": "Confermi il reset degli allarmi (IMPACT/THEFT -> IDLE)?"
        },
        "submit": {
          "variant": "destructive",
          "icon": "sync",
          "text": "Reset Alarms"
        },
        "reset": {
          "variant": "hidden"
        },
        "saveDefault": {
          "variant": "hidden"
        }
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": []
    }
  ]
}